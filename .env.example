# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# Google AI Studio key — powers the Ask tab and photo diagnosis.
# Without it the app still runs, answering from the knowledge base only.
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest in api/_lib/advisor.ts.
GEMINI_MODEL=

# Supabase project settings (Project Settings -> API).
# The server role key is used by /api/register and /api/telegram.
# It must stay server-side: never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (from @BotFather). Required for scripts/bot_dev_polling.py
# and scripts/setup_telegram_webhook.py.
TELEGRAM_BOT_TOKEN=

# Optional. Google Apps Script web app URL (docs/feedback-sheet.md) that
# receives feedback and sign-ups. Registration works without it.
FEEDBACK_WEBHOOK_URL=
